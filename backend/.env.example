# Copy to .env and fill in
DATABASE_URL=postgresql+psycopg2://pldhe:pldhe_secret@localhost:5432/pldhe

# Vapi.ai (get from https://dashboard.vapi.ai)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# n8n webhook that receives helpline-proxy dispatch jobs
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pldhe-helpline-dispatch

# Punjab Livestock & Dairy Development helpline (outbound proxy-call target)
HELPLINE_NUMBER=0800-78643

AUDIO_STORAGE_DIR=/app/audio_storage
